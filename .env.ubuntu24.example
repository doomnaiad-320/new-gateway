# Ubuntu 24.04 production starting point. Copy to .env and replace every CHANGE_ME value.
# Keep this service behind an HTTPS reverse proxy; this binds the app to loopback.
HOST=127.0.0.1
PORT=3124
GIN_MODE=release
DEBUG=false
DEFAULT_LANGUAGE=zh-CN
NODE_TYPE=master

# Generate two DIFFERENT values with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
CRYPTO_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
SESSION_COOKIE_SECURE=true
# Set this to the exact public HTTPS origin used to access the app.
SESSION_COOKIE_TRUSTED_URL=https://CHANGE_ME.example.com
# If the reverse proxy runs on this host, loopback is sufficient. For a proxy
# container or external load balancer, replace this with only its IP/CIDR.
TRUSTED_PROXIES=127.0.0.1,::1

# MySQL 8.x. Create this database/user first and replace both credentials.
SQL_DSN=CHANGE_ME_USER:CHANGE_ME_PASSWORD@tcp(127.0.0.1:3306)/new_api?charset=utf8mb4&parseTime=true&loc=Local
# Per database connection pool. Ensure MySQL max_connections can accommodate
# this pool multiplied by app instances, with room for migrations/admin access.
SQL_MAX_OPEN_CONNS=300
SQL_MAX_IDLE_CONNS=100
SQL_MAX_LIFETIME=1800
SQL_SLOW_THRESHOLD_MS=200

# Redis with a password, database index 1. URL-encode special password characters.
REDIS_CONN_STRING=redis://127.0.0.1:6379/1
REDIS_POOL_SIZE=200
SYNC_FREQUENCY=60
MEMORY_CACHE_ENABLED=true

# Batch quota updates to reduce write pressure on MySQL.
BATCH_UPDATE_ENABLED=true
BATCH_UPDATE_INTERVAL=5

# Keep upstream HTTP connections reusable under load. These are idle keep-alive
# connection limits, not a cap on active requests; size them for RAM/provider count.
RELAY_MAX_IDLE_CONNS=2000
RELAY_MAX_IDLE_CONNS_PER_HOST=500
RELAY_IDLE_CONN_TIMEOUT=90

# Per-client-IP request limits. Raise deliberately if legitimate traffic exceeds them.
GLOBAL_API_RATE_LIMIT_ENABLE=true
GLOBAL_API_RATE_LIMIT=6000
GLOBAL_API_RATE_LIMIT_DURATION=60
GLOBAL_WEB_RATE_LIMIT_ENABLE=true
GLOBAL_WEB_RATE_LIMIT=600
GLOBAL_WEB_RATE_LIMIT_DURATION=60

# Allow long-running streaming/upstream responses.
RELAY_TIMEOUT=0
RELAY_RESPONSE_HEADER_TIMEOUT=1800
STREAMING_TIMEOUT=300
SHUTDOWN_TIMEOUT_SECONDS=120
